          "anchors": [
            "some"
          ]
        },
        {
          "fact_id": "f2",
          "text": "By late October, the fix was ready, but before they could alert the world, the break-in attempts had begun.",
          "source_id": "source:primary",
          "captured_at": "2026-11-11T08:03:23.155584+08:00",
