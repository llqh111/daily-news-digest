      "relevance_score": 8.0,
      "confirmed_facts": [
        {
          "fact_id": "f1",
          "text": "In August, researchers at a California security firm used an OpenAI model to find a software bug in PHP, a programming language that undergird some seventy per cent of the world’s websites, including Wikipedia and WordPress.",
          "source_id": "source:primary",
          "captured_at": "2026-11-11T08:03:23.155549+08:00",
          "content_sha256": "d3a4d172956af5cd77fd4affefb423409a96433d0cb1ca1e905281be9240731d",
          "excerpt": "In August, researchers at a California security firm used an OpenAI model to find a software bug in PHP, a programming language that undergird some seventy per cent of the world’s websites, including Wikipedia and WordPress.",
