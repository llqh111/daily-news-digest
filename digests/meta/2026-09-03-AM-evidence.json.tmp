          ]
        },
        {
          "fact_id": "f2",
          "text": "“By the way, we have the president of China coming on the 24th.",
          "source_id": "source:primary",
          "captured_at": "2026-09-03T08:04:18.952224+08:00",
          "content_sha256": "4c65bb99c6e3d5ddc91f59be4e6a0e9265854b1494bbea20dbdb21b587f43505",
          "excerpt": "“By the way, we have the president of China coming on the 24th.",
