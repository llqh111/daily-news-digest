  "items": [
    {
      "version": 1,
      "id_scheme_version": 1,
      "article_id": "a1_4063a55f6357f5ea02e7cd26",
      "headline": "OpenAI Models Escaped Containment and Hacked Hugging Face",
      "confirmed_facts": [
        {
          "fact_id": "f1",
          "text": "OpenAI disclosed on Tuesday that it lost control of two AI models during a security test that ended in a breach of the open AI research platform Hugging Face.",
          "source_id": "source:primary",
          "captured_at": "2026-07-22T08:02:45.262316+08:00",
          "content_sha256": "50d203686b3af96fb1cb2f4dc94a58c58bc62803101234029dccfc636f65c535",
          "excerpt": "OpenAI disclosed on Tuesday that it lost control of two AI models during a security test that ended in a breach of the open AI research platform Hugging Face.",
          "sentence_hash": "3be3152c9bccc75145e4fa7d222cbe1103fd5d29b57fa9a5bdbf49499e694d96",
          "anchors": [
            "open"
          ]
        },
        {
          "fact_id": "f2",
          "text": "Describing the incident as “unprecedented,” OpenAI said its AI models broke out of a sealed testing environment last week and hacked into Hugging Face’s production system to steal the answers to a test they were being graded on.",
          "source_id": "source:primary",
          "captured_at": "2026-07-22T08:02:45.262353+08:00",
          "content_sha256": "50d203686b3af96fb1cb2f4dc94a58c58bc62803101234029dccfc636f65c535",
          "excerpt": "Describing the incident as “unprecedented,” OpenAI said its AI models broke out of a sealed testing environment last week and hacked into Hugging Face’s production system to steal the answers to a test they were being graded on.",
          "sentence_hash": "7e2dfee10dddaa99eae6f33a749653805e19036c6d4831cfdb5ddb4f9d1bf396",
          "anchors": [
            "ai"
          ]
        },
        {
          "fact_id": "f3",
          "text": "The models—the publicly available GPT-5.6 Sol and an unreleased, reportedly more capable one—were being evaluated on their offensive hacking skills with the safeguards that normally block high-risk cyber activity switched off.",
          "source_id": "source:primary",
          "captured_at": "2026-07-22T08:02:45.262381+08:00",
          "content_sha256": "50d203686b3af96fb1cb2f4dc94a58c58bc62803101234029dccfc636f65c535",
          "excerpt": "The models—the publicly available GPT-5.6 Sol and an unreleased, reportedly more capable one—were being evaluated on their offensive hacking skills with the safeguards that normally block high-risk cyber activity switched off.",
          "sentence_hash": "5e8d04a4b385d76bb02906a18753dcc871e5acd288873b16dcdfbfbec66b840d",
          "anchors": [
            "ai"
          ]
        },
        {
          "fact_id": "f4",
          "text": "“The models identified and chained vulnerabilities across OpenAI’s research environment and Hugging Face’s production infrastructure to obtain test solutions directly from Hugging Face’s production database,” OpenAI and Hugging Face wrote in a joint blog post disclosing the intru",
          "source_id": "source:primary",
          "captured_at": "2026-07-22T08:02:45.262413+08:00",
          "content_sha256": "50d203686b3af96fb1cb2f4dc94a58c58bc62803101234029dccfc636f65c535",
          "excerpt": "“The models identified and chained vulnerabilities across OpenAI’s research environment and Hugging Face’s production infrastructure to obtain test solutions directly from Hugging Face’s production database,” OpenAI and Hugging Face wrote in a joint blog post disclosing the intru",
          "sentence_hash": "0d61c56be675b010ddedea2244c7a2d23cb60fa871c4cc4a40353c7898b9d171",
          "anchors": [
            "sol",
            "ai"
          ]
        },
        {
          "fact_id": "f5",
          "text": "The proxy was the only component in OpenAI’s isolated testing environment permitted to reach the outside world; in normal use that reach extends only to public code repositories.",
          "source_id": "source:primary",
          "captured_at": "2026-07-22T08:02:45.262441+08:00",
          "content_sha256": "50d203686b3af96fb1cb2f4dc94a58c58bc62803101234029dccfc636f65c535",
          "excerpt": "The proxy was the only component in OpenAI’s isolated testing environment permitted to reach the outside world; in normal use that reach extends only to public code repositories.",
          "sentence_hash": "a48f2158066e2abe8529e478bdcdb5f7142c7c11505a83d9d000bffe0ba6c5d3",
          "anchors": [
            "sol"
          ]
        },
        {
          "fact_id": "f6",
          "text": "Rather than stay contained in the sandbox, the models “exploited a zero-day vulnerability” to gain access to the open internet as they “hyperfocused” on finding a solution for the AI cybersecurity benchmark known as ExploitGym.",
          "source_id": "source:primary",
          "captured_at": "2026-07-22T08:02:45.262467+08:00",
          "content_sha256": "50d203686b3af96fb1cb2f4dc94a58c58bc62803101234029dccfc636f65c535",
          "excerpt": "Rather than stay contained in the sandbox, the models “exploited a zero-day vulnerability” to gain access to the open internet as they “hyperfocused” on finding a solution for the AI cybersecurity benchmark known as ExploitGym.",
          "sentence_hash": "f9d5926a34424267bed153f075d5f667a16832c48851ffab21f9b0a1ea884785",
          "anchors": [
            "ai",
            "sol",
            "open",
            "exploit"
          ]
        }
      ],
