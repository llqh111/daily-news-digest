      "headline": "NVIDIA-NeMo/Switchyard",
      "confirmed_facts": [
        {
          "fact_id": "f1",
          "text": "It routes requests across providers, translates between OpenAI and Anthropic APIs, records operational metrics, and provides typed, composable routing algorithms.",
          "source_id": "source:primary",
          "captured_at": "2026-08-15T09:56:20.996986+08:00",
          "content_sha256": "15aa42a15a0cbb71a93fdab2b1ba654b726cff1385ca59e59e9497eecf17e35d",
          "excerpt": "It routes requests across providers, translates between OpenAI and Anthropic APIs, records operational metrics, and provides typed, composable routing algorithms.",
          "sentence_hash": "364afce3a21d045c64ae95739367c472e82e2cced787e5edfa28cd676ee0d5f9",
          "anchors": [
            "operational metrics",
            "id"
          ]
        },
        {
          "fact_id": "f2",
          "text": "Point a coding agent such as Claude Code or Codex at an open-source model.",
          "source_id": "source:primary",
          "captured_at": "2026-08-15T09:56:20.997016+08:00",
          "content_sha256": "15aa42a15a0cbb71a93fdab2b1ba654b726cff1385ca59e59e9497eecf17e35d",
          "excerpt": "Point a coding agent such as Claude Code or Codex at an open-source model.",
          "sentence_hash": "9af4c89a48d8dfd3781d5fd38f18ab34b7a7997c632c1d1b3dad483d6fc7cd77",
          "anchors": [
            "open"
          ]
        },
        {
          "fact_id": "f3",
          "text": "Switchyard translates between the OpenAI Chat, Anthropic Messages, and OpenAI Responses formats, so the agent keeps speaking its native API while the request is served by vLLM, NVIDIA NIM, Ollama, or any OpenAI-compatible endpoint.",
          "source_id": "source:primary",
          "captured_at": "2026-08-15T09:56:20.997073+08:00",
