        {
          "fact_id": "f2",
          "text": "MSI and PNY have just announced new prices for all RTX 50-series graphics cards for China, representing up to a 59% hike compared to MSRP.",
          "source_id": "source:primary",
          "captured_at": "2026-07-28T08:02:10.376919+08:00",
