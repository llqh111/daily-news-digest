          "anchors": [
            "us"
          ]
        },
        {
          "fact_id": "f4",
          "text": "The spokesman demanded an immediate end to what he called irresponsible accusations and said China would keep developing commercial cooperation with all parties on the basis of equality and mutual benefit.",
          "source_id": "source:primary",
          "captured_at": "2026-08-21T08:06:58.916356+08:00",
