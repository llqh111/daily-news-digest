          ]
        },
        {
          "fact_id": "f3",
          "text": "In Ukraine, a 66-year-old man and 64-year-old woman died after a private house was hit by a guided aerial bomb in the Zaporizhzhia region, officials said.",
          "source_id": "source:primary",
          "captured_at": "2026-08-17T08:03:27.729658+08:00",
          "content_sha256": "8b4ccde3ef9f72b91463bdbed9bbff161c6dd42771fc0de42e9e2132d1fbc66e",
          "excerpt": "In Ukraine, a 66-year-old man and 64-year-old woman died after a private house was hit by a guided aerial bomb in the Zaporizhzhia region, officials said.",
          "sentence_hash": "9726858f4bf5524f9316bb871edea4b3f3ea77dded4842246122ed6545676d52",
          "anchors": [
            "officials"
          ]
        },
        {
          "fact_id": "f4",
          "text": "Burnt books could be seen lying on the ground, while firefighters continue to douse the flames.",
