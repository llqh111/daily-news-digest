        {
          "fact_id": "f3",
          "text": "Two military programs One China-based actor used Claude to draft a fire-control specification for an anti-torpedo fire-control system (the core logic that determines when and where an anti-torpedo weapon should engage an incoming threat), test the potential system against U.S.",
          "source_id": "source:primary",
          "captured_at": "2026-09-14T08:03:21.967101+08:00",
          "content_sha256": "4c7efa8e182fd725ae17f59ed7b7c57f5a78536bc39c1a1ce95d5f2cb93e27dc",
          "excerpt": "Two military programs One China-based actor used Claude to draft a fire-control specification for an anti-torpedo fire-control system (the core logic that determines when and where an anti-torpedo weapon should engage an incoming threat), test the potential system against U.S.",
          "sentence_hash": "240d998769d308faeddb0287c7bbe7fbddbd078555cfa9d7f2162569a7f07933",
          "anchors": [
            "ai",
            "us"
          ]
        },
        {
          "fact_id": "f4",
          "text": "Another China-based defense and military-industrial researcher used Claude to develop about 16 software modules for electronic warfare and suppression of enemy air defenses.",
