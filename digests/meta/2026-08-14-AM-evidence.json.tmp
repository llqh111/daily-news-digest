    {
      "version": 1,
      "id_scheme_version": 1,
      "article_id": "a1_61fdcb48b1a9857eff59852c",
      "headline": "shiyu-coder/Kronos",
      "confirmed_facts": [
        {
          "fact_id": "f1",
          "text": "Kronos is the first open-source foundation model for financial candlesticks (K-lines), trained on data from over 45 global exchanges.",
          "source_id": "source:primary",
          "captured_at": "2026-08-14T08:04:25.254602+08:00",
          "content_sha256": "c612545041b743cac3cadb15376218cba8b7a399c18f4ff79ddadcc36cb2dde5",
          "excerpt": "Kronos is the first open-source foundation model for financial candlesticks (K-lines), trained on data from over 45 global exchanges.",
          "sentence_hash": "e47ac9ee48bb515723a01f58cfc30aa45d43ebf211d96193ac2294e73c5695d9",
          "anchors": [
            "for",
            "data",
            "first",
            "our"
          ]
        },
        {
          "fact_id": "f2",
          "text": "- 🚩 [2025.08.17] We have released the scripts for fine-tuning!",
          "source_id": "source:primary",
          "captured_at": "2026-08-14T08:04:25.254619+08:00",
          "content_sha256": "c612545041b743cac3cadb15376218cba8b7a399c18f4ff79ddadcc36cb2dde5",
          "excerpt": "- 🚩 [2025.08.17] We have released the scripts for fine-tuning!",
          "sentence_hash": "f8512479f3110244df7add379fd8423e5546b8ed81a5fa30c3da9e54b83662c9",
          "anchors": [
            "for"
          ]
        },
        {
          "fact_id": "f3",
          "text": "Check them out to adapt Kronos to your own tasks.",
          "source_id": "source:primary",
          "captured_at": "2026-08-14T08:04:25.254629+08:00",
          "content_sha256": "c612545041b743cac3cadb15376218cba8b7a399c18f4ff79ddadcc36cb2dde5",
          "excerpt": "Check them out to adapt Kronos to your own tasks.",
          "sentence_hash": "688d4654e4922cff1e95cf31951ba76a534ab8b33b89ad370dc430fcf3412e95",
          "anchors": [
            "our"
          ]
        },
        {
          "fact_id": "f4",
          "text": "Kronos is a family of decoder-only foundation models, pre-trained specifically for the \"language\" of financial markets—K-line sequences.",
          "source_id": "source:primary",
          "captured_at": "2026-08-14T08:04:25.254649+08:00",
          "content_sha256": "c612545041b743cac3cadb15376218cba8b7a399c18f4ff79ddadcc36cb2dde5",
          "excerpt": "Kronos is a family of decoder-only foundation models, pre-trained specifically for the \"language\" of financial markets—K-line sequences.",
          "sentence_hash": "3ece1039735ca8f4dd56a8d73da7e09687661903f39daab03aaf8594deafa1ec",
          "anchors": [
            "all",
            "for"
          ]
        },
        {
          "fact_id": "f5",
          "text": "Unlike general-purpose TSFMs, Kronos is designed to handle the unique, high-noise characteristics of financial data.",
