      "confirmed_facts": [
        {
          "fact_id": "f1",
          "text": "Cloud | Documentation | Roadmap | Discord 📕 Table of Contents RAGFlow is a leading open-source Retrieval-Augmented Generation (RAG) engine that fuses cutting-edge RAG with Agent capabilities to create a superior context layer for LLMs.",
          "source_id": "source:primary",
          "captured_at": "2026-08-14T08:04:25.250703+08:00",
          "content_sha256": "31bfbe32aa3b638ddb11ee4e7b26531c09d0a6d0cbdbad8832b9ba621c788b02",
          "excerpt": "Cloud | Documentation | Roadmap | Discord 📕 Table of Contents RAGFlow is a leading open-source Retrieval-Augmented Generation (RAG) engine that fuses cutting-edge RAG with Agent capabilities to create a superior context layer for LLMs.",
          "sentence_hash": "0bf6a98689872e8b4d19e0f242c8e13237f4670dfbfd5f3cbf1d54891133c05a",
          "anchors": [
            "open"
          ]
        },
        {
          "fact_id": "f2",
          "text": "It offers a streamlined RAG workflow adaptable to enterprises of any scale.",
          "source_id": "source:primary",
          "captured_at": "2026-08-14T08:04:25.250723+08:00",
          "content_sha256": "31bfbe32aa3b638ddb11ee4e7b26531c09d0a6d0cbdbad8832b9ba621c788b02",
          "excerpt": "It offers a streamlined RAG workflow adaptable to enterprises of any scale.",
          "sentence_hash": "2a6985e9567ce60698a9a338644513090b399c6658a009d2d074bdc1efbe2a9b",
          "anchors": [
            "flow",
            "table",
            "line",
            "streamlined"
          ]
        },
        {
          "fact_id": "f3",
          "text": "Powered by a converged context engine and pre-built agent templates, RAGFlow enables developers to transform complex data into high-fidelity, production-ready AI systems with exceptional efficiency and precision.",
          "source_id": "source:primary",
          "captured_at": "2026-08-14T08:04:25.250749+08:00",
          "content_sha256": "31bfbe32aa3b638ddb11ee4e7b26531c09d0a6d0cbdbad8832b9ba621c788b02",
          "excerpt": "Powered by a converged context engine and pre-built agent templates, RAGFlow enables developers to transform complex data into high-fidelity, production-ready AI systems with exceptional efficiency and precision.",
          "sentence_hash": "3b0ef317923cda8d732982c4f1bc25104850ddd03317cb65a5b1163c72fb3c24",
          "anchors": [
            "pro",
            "agent"
          ]
        },
        {
          "fact_id": "f4",
          "text": "Try our cloud service at https://cloud.ragflow.io.",
          "source_id": "source:primary",
          "captured_at": "2026-08-14T08:04:25.250763+08:00",
          "content_sha256": "31bfbe32aa3b638ddb11ee4e7b26531c09d0a6d0cbdbad8832b9ba621c788b02",
          "excerpt": "Try our cloud service at https://cloud.ragflow.io.",
          "sentence_hash": "39c89f6b90875aadd1fc1f607dba83d1d0989e10a167e0ceb64b14678dc1842e",
