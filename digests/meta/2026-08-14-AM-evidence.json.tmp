    {
      "version": 1,
      "id_scheme_version": 1,
      "article_id": "a1_b2f123864604ecb052c66f22",
      "headline": "macro-inc/macro",
      "confirmed_facts": [
        {
          "fact_id": "f1",
          "text": "Macro is the all-in-one workspace for you and your team.",
          "source_id": "source:primary",
          "captured_at": "2026-08-14T08:04:25.252196+08:00",
          "content_sha256": "ce3ea7f19718c804cbc6b199f446171379cfbee465be00753c843683d9ba2e5f",
          "excerpt": "Macro is the all-in-one workspace for you and your team.",
          "sentence_hash": "eb8a179157198aeb327246c87fb1f8e98ae4b74d01307c2d5833a7cb6a2da817",
          "anchors": [
            "you",
            "for",
            "all"
          ]
        },
        {
          "fact_id": "f2",
          "text": "It unifies email + messages + docs + tasks + agents + CRM into a single fast interface with shared team-level memory.",
          "source_id": "source:primary",
          "captured_at": "2026-08-14T08:04:25.252212+08:00",
          "content_sha256": "ce3ea7f19718c804cbc6b199f446171379cfbee465be00753c843683d9ba2e5f",
          "excerpt": "It unifies email + messages + docs + tasks + agents + CRM into a single fast interface with shared team-level memory.",
          "sentence_hash": "7f409c164fa0a827bc1ab9026eeb7b26e526265ab49488f75aef592a64cafd21",
          "anchors": [
            "ai"
          ]
        },
        {
          "fact_id": "f3",
          "text": "Everything in your workspace is @linked and searchable so your team (and your agents) never have to switch tools.",
          "source_id": "source:primary",
          "captured_at": "2026-08-14T08:04:25.252226+08:00",
          "content_sha256": "ce3ea7f19718c804cbc6b199f446171379cfbee465be00753c843683d9ba2e5f",
          "excerpt": "Everything in your workspace is @linked and searchable so your team (and your agents) never have to switch tools.",
          "sentence_hash": "c27cd54d09fec36125de405f6dca5e9374e8daa6353d8439c8db07fca8f9b44b",
          "anchors": [
            "you"
          ]
        },
        {
          "fact_id": "f4",
          "text": "We built Macro because we wanted a single operating system for our startup.",
          "source_id": "source:primary",
          "captured_at": "2026-08-14T08:04:25.252238+08:00",
          "content_sha256": "ce3ea7f19718c804cbc6b199f446171379cfbee465be00753c843683d9ba2e5f",
          "excerpt": "We built Macro because we wanted a single operating system for our startup.",
          "sentence_hash": "07a333aae1240159180e7ccda51528c7468d2a3ba0dc6397a06b937147542205",
          "anchors": [
            "for",
            "use",
            "built"
          ]
        },
        {
          "fact_id": "f5",
          "text": "There are many good software products, and we used them all — Slack, Linear, Notion, HubSpot, and Superhuman — but they don't work together as one system.",
          "source_id": "source:primary",
          "captured_at": "2026-08-14T08:04:25.252258+08:00",
          "content_sha256": "ce3ea7f19718c804cbc6b199f446171379cfbee465be00753c843683d9ba2e5f",
          "excerpt": "There are many good software products, and we used them all — Slack, Linear, Notion, HubSpot, and Superhuman — but they don't work together as one system.",
          "sentence_hash": "946516a73d2eb8d779bca11d56b791bce717fd164840f537e07c82958cb087b5",
          "anchors": [
            "all",
            "use"
          ]
        },
        {
          "fact_id": "f6",
          "text": "As we scaled our last venture to ~20 people things started to break: every team got their own tools and the company was held together by MCP and Zapier.",
          "source_id": "source:primary",
          "captured_at": "2026-08-14T08:04:25.252275+08:00",
          "content_sha256": "ce3ea7f19718c804cbc6b199f446171379cfbee465be00753c843683d9ba2e5f",
          "excerpt": "As we scaled our last venture to ~20 people things started to break: every team got their own tools and the company was held together by MCP and Zapier.",
          "sentence_hash": "f026eaafe6eb2d61e0e607a2ad0df8676af50e74a1f81c4c0f85862ec9f18977",
          "anchors": [
            "20 people",
            "company"
          ]
        }
