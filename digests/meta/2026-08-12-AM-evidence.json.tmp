          ]
        },
        {
          "fact_id": "f3",
          "text": "Skills are folders of instructions, scripts, and resources that Claude loads dynamically to improve performance on specialized tasks.",
          "source_id": "source:primary",
          "captured_at": "2026-08-12T08:03:39.331320+08:00",
          "content_sha256": "2bfcc99b7b408271152774dc5efddcfc1553d2d0d65904e582779c28403361c6",
          "excerpt": "Skills are folders of instructions, scripts, and resources that Claude loads dynamically to improve performance on specialized tasks.",
          "sentence_hash": "dd931a80e0664f11f80c9265e842384816200541fd7d3035469f351f532ec360",
          "anchors": [
            "for"
          ]
        },
        {
          "fact_id": "f4",
          "text": "Skills teach Claude how to complete specific tasks in a repeatable way, whether that's creating documents with your company's brand guidelines, analyzing data using your organization's specific workflows, or automating personal tasks.",
